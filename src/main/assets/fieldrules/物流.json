{
  "_说明": "物流货运 字段规则库（规则名全库唯一，模板业务列只留 name/type/rule，改本文件即改本行业抽取）。synonyms=列名之外还要认的标签词；clean=形态/兜底(title/money/datetime/phone/link/longtext/text)；re=无标签裸值正则（仅当 标签/title 未命中才用）。",
  "物流_线路": {
    "clean": "text",
    "synonyms": [
      "路线",
      "专线"
    ],
    "re": [
      "([\\u4e00-\\u9fa5A-Za-z0-9]{1,10}(?:市|省|区|县|港|站)?\\s*[-－—~至]\\s*[\\u4e00-\\u9fa5A-Za-z0-9]{1,10}(?:市|省|区|县|港|站)?)"
    ]
  },
  "物流_出发地": {
    "clean": "text",
    "synonyms": [
      "起运地",
      "始发地",
      "装货地"
    ]
  },
  "物流_到达地": {
    "clean": "text",
    "synonyms": [
      "目的地",
      "卸货地",
      "收货地"
    ]
  },
  "物流_重量": {
    "clean": "text",
    "synonyms": [
      "载重",
      "限重"
    ],
    "re": [
      "([0-9]+(?:\\.[0-9]+)?)\\s*(?:吨|kg|KG|公斤|千克)"
    ]
  },
  "物流_体积": {
    "clean": "text",
    "synonyms": [
      "方数"
    ],
    "re": [
      "([0-9]+(?:\\.[0-9]+)?)\\s*(?:立方米|立方|m³|方|CBM)"
    ]
  },
  "物流_时效": {
    "clean": "text",
    "synonyms": [
      "运输时效",
      "时效承诺",
      "运输时间"
    ],
    "re": [
      "(次日达|当日达|隔日达|[0-9]+(?:\\.[0-9]+)?\\s*天(?:内)?|[0-9]+\\s*小时(?:内)?)"
    ]
  },
  "物流_运费": {
    "clean": "money",
    "synonyms": [
      "报价",
      "单价"
    ]
  },
  "物流_服务商": {
    "clean": "text",
    "synonyms": [
      "物流公司",
      "承运商",
      "公司"
    ]
  },
  "物流_备注": {
    "clean": "text",
    "synonyms": [
      "说明"
    ]
  }
}
