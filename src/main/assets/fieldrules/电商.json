    "re": [
      "([0-9][0-9,]*(?:\\.\\d+)?[万]?)\\+?\\s*(?:人付款|人已付款|笔已售|件已售|累计评价|条评价)",
      "(?:已售|月销|销量)\\s*([0-9][0-9,]*(?:\\.\\d+)?[万]?)\\+?"
