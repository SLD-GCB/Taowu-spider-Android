{
  "_说明": "汽车报价 字段规则库（规则名全库唯一，模板业务列只留 name/type/rule，改本文件即改本行业抽取）。synonyms=列名之外还要认的标签词；clean=形态/兜底(title/money/datetime/phone/link/longtext/text)；re=无标签裸值正则（仅当 标签/title 未命中才用）。",
  "汽车_车型": {
    "clean": "title",
    "synonyms": [
      "车系",
      "车型名称"
    ]
  },
  "汽车_品牌": {
    "clean": "text",
    "synonyms": [
      "汽车品牌",
      "所属品牌"
    ]
  },
  "汽车_厂商": {
    "clean": "text",
    "synonyms": [
      "厂商指导价归属",
      "生产厂商",
      "生产企业"
    ],
    "re": [
      "([\\u4e00-\\u9fa5]{2,18}(?:汽车有限公司|汽车股份|汽车集团|汽车工业|有限公司|集团))"
    ]
  },
  "汽车_指导价": {
    "clean": "money",
    "synonyms": [
      "厂商指导价",
      "官方指导价"
    ]
  },
  "汽车_经销商价": {
    "clean": "money",
    "synonyms": [
      "参考价",
      "经销商参考价",
      "经销商报价",
      "裸车价"
    ]
  },
  "汽车_上市时间": {
    "clean": "datetime",
    "synonyms": [
      "上市日期",
      "上市"
    ]
  },
  "汽车_排量": {
    "clean": "text",
    "synonyms": [
      "排气量"
    ],
    "re": [
      "([0-9](?:\\.[0-9])?)\\s*(?:L|升)"
    ]
  },
  "汽车_变速箱": {
    "clean": "text",
    "synonyms": [
      "变速器",
      "变速箱类型"
    ],
    "re": [
      "([0-9]+挡[A-Za-z]*手自一体|CVT无级变速|[0-9]+挡双离合|手自一体|无级变速|CVT|双离合|DCT|自动挡|手动挡)"
    ]
  },
  "汽车_车身类型": {
    "clean": "text",
    "synonyms": [
      "车身形式"
    ],
    "re": [
      "(中大型SUV|紧凑型SUV|SUV|MPV|轿车|跑车|皮卡|旅行车|跨界车|三厢车|两厢车|掀背车)"
    ]
  }
}
