{
  "_说明": "商标信息 字段规则库（规则名全库唯一，模板业务列只留 name/type/rule，改本文件即改本行业抽取）。synonyms=列名之外还要认的标签词；clean=形态/兜底(title/money/datetime/phone/link/longtext/text)；re=无标签裸值正则（仅当 标签/title 未命中才用）。",
  "商标_商标名称": {
    "clean": "title",
    "synonyms": [
      "商标",
      "商标文字",
      "名称"
    ]
  },
  "商标_注册号": {
    "clean": "text",
    "synonyms": [
      "申请号",
      "商标注册号",
      "注册编号"
    ]
  },
  "商标_申请人": {
    "clean": "text",
    "synonyms": [
      "注册人",
      "申请人名称"
    ]
  },
  "商标_申请日期": {
    "clean": "datetime",
    "synonyms": [
      "申请日"
    ]
  },
