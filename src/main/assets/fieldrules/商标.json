    "re": [
      "(?:至|~|—|到)\\s*(20\\d{2}[-/年.]\\d{1,2}[-/月.]\\d{1,2})"
    ]
  },
  "商标_代理机构": {
    "clean": "text",
    "synonyms": [
      "代理",
      "商标代理"
    ]
  },
  "商标_图片链接": {
