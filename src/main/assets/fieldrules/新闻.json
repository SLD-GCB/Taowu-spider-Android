{
  "_说明": "新闻资讯 字段规则库（规则名全库唯一，模板业务列只留 name/type/rule，改本文件即改本行业抽取）。synonyms=列名之外还要认的标签词；clean=形态/兜底(title/money/datetime/phone/link/longtext/text)；re=无标签裸值正则（仅当 标签/title 未命中才用）。",
  "新闻_标题": {
    "clean": "title",
    "synonyms": [
      "新闻标题"
    ]
  },
  "新闻_作者": {
    "clean": "text",
    "synonyms": [
      "记者",
      "撰稿",
      "通讯员"
    ]
  },
  "新闻_发布时间": {
    "clean": "datetime",
    "synonyms": [
      "发表日期",
      "时间"
    ]
  },
  "新闻_栏目": {
    "clean": "text",
    "synonyms": [
      "频道",
      "版块"
    ]
  },
  "新闻_来源媒体": {
    "clean": "text",
    "synonyms": [
      "来源",
      "媒体",
      "来源网站",
      "媒体名称"
    ]
  },
  "新闻_关键词": {
    "clean": "text",
    "synonyms": [
      "标签",
      "关键字",
      "主题词"
    ]
  },
  "新闻_摘要": {
    "clean": "text",
    "synonyms": [
