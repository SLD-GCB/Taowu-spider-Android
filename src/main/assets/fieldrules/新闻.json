      "新闻内容"
    ]
  },
  "新闻_阅读量": {
    "clean": "text",
    "synonyms": [
      "浏览量",
      "点击量"
    ],
    "re": [
      "([0-9][0-9,]*(?:万)?)\\s*[＋+]?\\s*(?:次阅读|人阅读|人浏览|次浏览|浏览量|点击量|人气|热度|人看过)"
    ]
  }
}
