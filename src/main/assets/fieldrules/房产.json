{
  "_说明": "房产租售 字段规则库（规则名全库唯一，模板业务列只留 name/type/rule，改本文件即改本行业抽取）。synonyms=列名之外还要认的标签词；clean=形态/兜底(title/money/datetime/phone/link/longtext/text)；re=无标签裸值正则（仅当 标签/title 未命中才用）。",
  "房产_标题": {
    "clean": "title",
    "synonyms": [
      "房源标题"
    ]
  },
  "房产_小区": {
    "clean": "text",
    "synonyms": [
      "楼盘",
      "小区名称",
      "楼盘名称"
    ]
  },
  "房产_户型": {
    "clean": "text",
    "synonyms": [
      "房屋户型"
    ],
    "re": [
      "([0-9]{1,2}室[0-9]{1,2}厅(?:[0-9]{1,2}卫)?|[0-9]{1,2}室[0-9]{1,2}卫|[0-9]{1,2}居)"
    ]
  },
  "房产_面积": {
    "clean": "text",
    "synonyms": [
      "建筑面积",
      "套内面积"
    ],
    "re": [
      "([0-9]+(?:\\.[0-9]+)?)\\s*(?:㎡|平方米|平米|平方|平)"
    ]
  },
  "房产_朝向": {
    "clean": "text",
    "synonyms": [
      "房屋朝向"
    ],
    "re": [
      "(南北通透|朝南|朝北|朝东|朝西|南向|北向|东向|西向|东南|西南|东北|西北)"
    ]
  },
  "房产_楼层": {
    "clean": "text",
    "re": [
      "((?:低|中|高)楼层|顶楼|共[0-9]{1,3}层|第?[0-9]{1,3}\\s*层|(?:第)?[0-9]{1,3}\\s*/\\s*[0-9]{1,3}\\s*层)"
    ]
  },
  "房产_总价": {
    "clean": "money",
    "synonyms": [
      "售价",
      "挂牌价",
      "总房价"
    ]
  },
  "房产_单价": {
    "clean": "money",
    "synonyms": [
      "均价",
      "每平米价"
    ]
  },
  "房产_区域": {
    "clean": "text",
    "synonyms": [
      "地址",
      "位置",
      "所在区域"
    ]
  }
}
