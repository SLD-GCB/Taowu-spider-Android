<?xml version="1.0" encoding="utf-8"?>
<!-- 大量视频 CDN 走明文 http，Android 9+ 默认禁明文 → 必须显式放开，否则 Media3 直接报错。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
